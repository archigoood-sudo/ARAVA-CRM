generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  COACH
}

enum StudentStatus {
  ACTIVE
  TRIAL
  FROZEN
  LEFT
  ARCHIVED
}

enum StudentDocumentType {
  CONTRACT
  PERSONAL_DATA_CONSENT
  MEDIA_CONSENT
}

enum StudentDocumentSource {
  GENERATED
  EXISTING
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum GroupStatus {
  ACTIVE
  RECRUITING
  PAUSED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  TRIAL
  FROZEN
  LEFT
}

enum LessonStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
  TRIAL
}

enum TrialAppointmentStatus {
  BOOKED
  CANCELLED
}

enum TrialOutcome {
  PURCHASED
  THINKING
  DECLINED
  NO_SHOW
}

enum TariffType {
  LESSON_PACK
  UNLIMITED
  SINGLE_LESSON
  TRIAL
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  EXPIRED
  FROZEN
  CANCELLED
  USED_UP
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
  SBP
  ACQUIRING
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentOperationStatus {
  CREATED
  WAITING_FOR_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentProviderType {
  NONE
  SBP
  ACQUIRING
}

enum LedgerOperationType {
  PURCHASE
  LESSON_WRITE_OFF
  REVERSAL
  MANUAL_ADJUSTMENT
  FREEZE
  UNFREEZE
}

enum ExpensePaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum ExpenseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum CashRegisterType {
  CASH
  BANK
  ONLINE
}

enum CashTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  CORRECTION
}

enum CashTransactionSource {
  PAYMENT
  REFUND
  EXPENSE
  PAYROLL
  MANUAL
}

enum PayrollType {
  FIXED_PER_LESSON
  PER_ATTENDEE
  PERCENT_OF_REVENUE
  FIXED_MONTHLY
  COMBINED
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum RoomRentalStatus {
  ACTIVE
  CANCELLED
  ARCHIVED
}

enum CalendarExceptionType {
  DAY_OFF
  HOLIDAY
  VACATION
  CUSTOM
}

enum MembershipCardStatus {
  FREE
  ASSIGNED
  BLOCKED
  LOST
  ARCHIVED
}

enum CardEventType {
  REGISTERED
  ASSIGNED
  UNASSIGNED
  BLOCKED
  MARKED_LOST
  REACTIVATED
  REPLACED
  ARCHIVED
  SCANNED
}

enum CardScanResult {
  OPENED
  FREE
  UNKNOWN
  BLOCKED
  LOST
  ARCHIVED
  ACCESS_DENIED
}

enum SyncOutboxStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
}

enum SyncOperation {
  UPSERT
  ARCHIVE
}

enum PublicationType {
  NEWS
  ANNOUNCEMENT
  EVENT
  INFO
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PublicationAudienceMode {
  ALL_CLIENTS
  BRANCHES
  GROUPS
  TRAINERS
}

enum PublicationTargetType {
  BRANCH
  GROUP
}

model User {
  id                     String                @id @default(cuid())
  email                  String                @unique
  fullName               String
  passwordHash           String
  role                   UserRole
  isActive               Boolean               @default(true)
  mustChangePassword     Boolean               @default(false)
  phone                  String?
  trainerDescription     String?
  failedLoginAttempts    Int                   @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  passwordChangedAt      DateTime?
  securityVersion        Int                   @default(1)
  recoveryCodeHash       String?
  recoveryCodeCreatedAt  DateTime?
  recoveryFailedAttempts Int                   @default(0)
  recoveryLockedUntil    DateTime?
  branchAssignments      UserBranch[]
  sessions               Session[]
  coachedGroups          DanceGroup[]          @relation("GroupCoach")
  assistedGroups         DanceGroup[]          @relation("GroupAssistant")
  scheduleTemplates      WeeklySchedule[]      @relation("ScheduleCoach")
  lessons                Lesson[]              @relation("LessonCoach")
  attendanceMarks        Attendance[]
  auditLogs              AuditLog[]
  createdSubscriptions   Subscription[]        @relation("SubscriptionCreator")
  createdPayments          Payment[]          @relation("PaymentCreator")
  createdPaymentOperations PaymentOperation[] @relation("PaymentOperationCreator")
  createdRefunds         Refund[]              @relation("RefundCreator")
  ledgerEntries          SubscriptionLedger[]  @relation("LedgerCreator")
  createdExpenses        Expense[]             @relation("ExpenseCreator")
  confirmedExpenses      Expense[]             @relation("ExpenseConfirmer")
  cashTransactions       CashTransaction[]
  payrollRules           PayrollRule[]         @relation("PayrollCoach")
  createdPayrolls        PayrollPeriod[]       @relation("PayrollCreator")
  approvedPayrolls       PayrollPeriod[]       @relation("PayrollApprover")
  payrollAccruals        PayrollAccrual[]      @relation("PayrollAccrualCoach")
  createdRoomRentals     RoomRental[]          @relation("RoomRentalCreator")
  createdRoomClosures    RoomClosure[]         @relation("RoomClosureCreator")
  createdSubstitutions   TrainerSubstitution[] @relation("SubstitutionCreator")
  substitutedLessons     TrainerSubstitution[] @relation("SubstituteTrainer")
  originalSubstitutions  TrainerSubstitution[] @relation("OriginalTrainer")
  createdTrialAppointments TrialAppointment[]  @relation("TrialAppointmentCreator")
  createdMembershipCards MembershipCard[]      @relation("CardCreator")
  performedCardEvents    CardEvent[]           @relation("CardEventPerformer")
  cardScans              CardScanEvent[]       @relation("CardScanPerformer")
  createdPublications    Publication[]         @relation("PublicationCreator")
  studentNotes           StudentNote[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([role, isActive])
  @@index([lockedUntil])
}

model Session {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())
  securityVersion Int      @default(1)

  @@index([userId])
  @@index([userId, securityVersion])
  @@index([expiresAt])
}

model Branch {
  id                 String              @id @default(cuid())
  name               String
  address            String?
  phone              String?
  description        String?
  isActive           Boolean             @default(true)
  users              UserBranch[]
  students           Student[]
  groups             DanceGroup[]
  schedules          WeeklySchedule[]
  lessons            Lesson[]
  tariffs            Tariff[]
  subscriptions      Subscription[]
  payments           Payment[]
  paymentOperations  PaymentOperation[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  cashRegisters      CashRegister[]
  cashTransactions   CashTransaction[]
  payrollRules       PayrollRule[]
  payrollPeriods     PayrollPeriod[]
  payrollAccruals    PayrollAccrual[]
  rooms              Room[]
  roomRentals        RoomRental[]
  calendarExceptions CalendarException[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  archivedAt         DateTime?

  @@index([name])
  @@index([isActive])
  @@index([archivedAt])
}

model Room {
  id               String           @id @default(cuid())
  branchId         String
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name             String
  capacity         Int?
  description      String?
  floor            String?
  areaSquareMeters Float?
  colorKey         String?
  isActive         Boolean          @default(true)
  archivedAt       DateTime?
  sortOrder        Int              @default(0)
  schedules        WeeklySchedule[]
  lessons          Lesson[]
  rentals          RoomRental[]
  closures         RoomClosure[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([branchId, name])
  @@index([branchId, isActive, sortOrder])
  @@index([archivedAt])
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model Student {
  id              String               @id @default(cuid())
  firstName       String
  lastName        String
  middleName      String?
  birthDate       DateTime?
  gender          Gender?
  phone           String?
  email           String?
  status          StudentStatus        @default(ACTIVE)
  branchId        String
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  notes           String?
  contacts        StudentContact[]
  enrollments     Enrollment[]
  attendance      Attendance[]
  subscriptions   Subscription[]
  payments        Payment[]
  paymentOperations PaymentOperation[]
  ledgerEntries   SubscriptionLedger[]
  membershipCards MembershipCard[]
  cardEvents      CardEvent[]
  cardScans       CardScanEvent[]
  profileNotes    StudentNote[]
  trialAppointments TrialAppointment[]
  documents       StudentDocument[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  archivedAt      DateTime?

  @@index([branchId, status])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([archivedAt])
}

model MembershipCard {
  id              String               @id @default(cuid())
  barcode         String               @unique
  studentId       String?
  student         Student?             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status          MembershipCardStatus @default(FREE)
  issuedAt        DateTime?
  unassignedAt    DateTime?
  blockedAt       DateTime?
  archivedAt      DateTime?
  notes           String?
  createdByUserId String
  createdByUser   User                 @relation("CardCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events          CardEvent[]          @relation("CardEventCard")
  relatedEvents   CardEvent[]          @relation("CardEventRelatedCard")
  scans           CardScanEvent[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([studentId, status])
  @@index([status, createdAt])
  @@index([createdByUserId])
}

model CardEvent {
  id                String          @id @default(cuid())
  cardId            String
  card              MembershipCard  @relation("CardEventCard", fields: [cardId], references: [id], onDelete: Restrict)
  studentId         String?
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  eventType         CardEventType
  performedByUserId String?
  performedByUser   User?           @relation("CardEventPerformer", fields: [performedByUserId], references: [id], onDelete: SetNull)
  relatedCardId     String?
  relatedCard       MembershipCard? @relation("CardEventRelatedCard", fields: [relatedCardId], references: [id], onDelete: Restrict)
  occurredAt        DateTime        @default(now())
  comment           String?

  @@index([cardId, occurredAt])
  @@index([studentId, occurredAt])
  @@index([performedByUserId, occurredAt])
  @@index([eventType, occurredAt])
}

model CardScanEvent {
  id                String          @id @default(cuid())
  barcode           String
  cardId            String?
  card              MembershipCard? @relation(fields: [cardId], references: [id], onDelete: Restrict)
  studentId         String?
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  performedByUserId String?
  performedByUser   User?           @relation("CardScanPerformer", fields: [performedByUserId], references: [id], onDelete: SetNull)
  result            CardScanResult
  occurredAt        DateTime        @default(now())

  @@index([barcode, occurredAt])
  @@index([cardId, occurredAt])
  @@index([studentId, occurredAt])
  @@index([performedByUserId, occurredAt])
  @@index([result, occurredAt])
}

model DanceGroup {
  id               String           @id @default(cuid())
  name             String
  branchId         String
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  direction        String
  ageFrom          Int?
  ageTo            Int?
  coachId          String?
  coach            User?            @relation("GroupCoach", fields: [coachId], references: [id], onDelete: SetNull)
  assistantCoachId String?
  assistantCoach   User?            @relation("GroupAssistant", fields: [assistantCoachId], references: [id], onDelete: SetNull)
  capacity         Int              @default(20)
  status           GroupStatus      @default(RECRUITING)
  description      String?
  color            String?
  enrollments      Enrollment[]
  schedules        WeeklySchedule[]
  lessons          Lesson[]
  trialAppointments TrialAppointment[]
  payrollRules     PayrollRule[]
  payrollAccruals  PayrollAccrual[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  archivedAt       DateTime?

  @@index([branchId, status])
  @@index([coachId])
  @@index([assistantCoachId])
  @@index([name])
  @@index([direction])
  @@index([archivedAt])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     DanceGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime
  leftAt    DateTime?
  status    EnrollmentStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([studentId, status])
  @@index([groupId, status])
  @@index([groupId, leftAt])
}

model WeeklySchedule {
  id         String     @id @default(cuid())
  groupId    String
  group      DanceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  weekday    Int
  startTime  String
  endTime    String
  room       String?
  roomId     String?
  roomEntity Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  coachId    String?
  coach      User?      @relation("ScheduleCoach", fields: [coachId], references: [id], onDelete: SetNull)
  validFrom  DateTime
  validTo    DateTime?
  isActive   Boolean    @default(true)
  lessons    Lesson[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([branchId, weekday, isActive])
  @@index([groupId, isActive])
  @@index([coachId, weekday, isActive])
  @@index([room, weekday, isActive])
  @@index([roomId, weekday, isActive])
}

model Lesson {
  id                    String               @id @default(cuid())
  groupId               String
  group                 DanceGroup           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  branchId              String
  branch                Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coachId               String?
  coach                 User?                @relation("LessonCoach", fields: [coachId], references: [id], onDelete: SetNull)
  scheduleTemplateId    String?
  scheduleTemplate      WeeklySchedule?      @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  startsAt              DateTime
  endsAt                DateTime
  room                  String?
  roomId                String?
  roomEntity            Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  status                LessonStatus         @default(PLANNED)
  cancellationReason    String?
  notes                 String?
  attendanceCompletedAt DateTime?
  attendance            Attendance[]
  ledgerEntries         SubscriptionLedger[]
  payrollAccruals       PayrollAccrual[]
  substitution          TrainerSubstitution?
  trialAppointments     TrialAppointment[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([groupId, startsAt])
  @@index([branchId, startsAt])
  @@index([coachId, startsAt])
  @@index([scheduleTemplateId])
  @@index([status, startsAt])
  @@index([roomId, startsAt])
  @@index([groupId, startsAt])
  @@index([attendanceCompletedAt])
}

model TrialAppointment {
  id              String     @id @default(cuid())
  externalLeadId  String
  studentId       String?
  student         Student?   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  groupId         String
  group           DanceGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  lessonId        String
  lesson          Lesson     @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  createdByUserId String
  createdByUser   User       @relation("TrialAppointmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  status          TrialAppointmentStatus @default(BOOKED)
  outcome         TrialOutcome?
  cancelledAt     DateTime?
  version         Int        @default(1)
  supersededAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([externalLeadId, lessonId])
  @@index([externalLeadId, supersededAt])
  @@index([studentId, supersededAt])
  @@index([lessonId, supersededAt])
  @@index([groupId, supersededAt])
  @@index([createdByUserId])
}

model RoomRental {
  id              String           @id @default(cuid())
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomId          String
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startAt         DateTime
  endAt           DateTime
  clientName      String?
  phone           String?
  amount          Int?
  comment         String?
  status          RoomRentalStatus @default(ACTIVE)
  createdByUserId String
  createdByUser   User             @relation("RoomRentalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([branchId, startAt])
  @@index([roomId, startAt, endAt])
  @@index([status, startAt])
}

model RoomClosure {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startAt         DateTime
  endAt           DateTime
  reason          String
  comment         String?
  createdByUserId String
  createdByUser   User     @relation("RoomClosureCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([roomId, startAt, endAt])
}

model CalendarException {
  id        String                @id @default(cuid())
  branchId  String?
  branch    Branch?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  startAt   DateTime
  endAt     DateTime
  type      CalendarExceptionType
  title     String
  comment   String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([branchId, startAt, endAt])
  @@index([type, startAt])
}

model TrainerSubstitution {
  id                  String   @id @default(cuid())
  lessonId            String   @unique
  lesson              Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  originalTrainerId   String?
  originalTrainer     User?    @relation("OriginalTrainer", fields: [originalTrainerId], references: [id], onDelete: SetNull)
  substituteTrainerId String
  substituteTrainer   User     @relation("SubstituteTrainer", fields: [substituteTrainerId], references: [id], onDelete: Restrict)
  reason              String?
  createdByUserId     String
  createdByUser       User     @relation("SubstitutionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now())

  @@index([substituteTrainerId, createdAt])
}

model Attendance {
  lessonId       String
  lesson         Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus
  markedByUserId String
  markedByUser   User             @relation(fields: [markedByUserId], references: [id], onDelete: Restrict)
  markedAt       DateTime
  comment        String?
  directPaymentId          String?           @unique
  directPaymentOperationId String?           @unique
  directPaymentTariffId    String?

  @@id([lessonId, studentId])
  @@index([studentId, markedAt])
  @@index([markedByUserId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  entityType  String
  entityId    String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model Tariff {
  id            String         @id @default(cuid())
  name          String
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type          TariffType
  lessonCount   Int?
  validityDays  Int?
  price         Int
  currency      String         @default("RUB")
  freezeDays    Int?
  isActive      Boolean        @default(true)
  description   String?
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  @@index([branchId, isActive])
  @@index([type, isActive])
  @@index([name])
  @@index([archivedAt])
}

model Subscription {
  id              String               @id @default(cuid())
  studentId       String
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  tariffId        String
  tariff          Tariff               @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  branchId        String
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchasedAt     DateTime
  startsAt        DateTime
  expiresAt       DateTime?
  lessonLimit     Int?
  lessonsUsed     Int                  @default(0)
  status          SubscriptionStatus   @default(PENDING)
  freezeStartedAt DateTime?
  freezeEndsAt    DateTime?
  frozenDaysUsed  Int                  @default(0)
  salePrice       Int
  saleIdempotencyKey String?             @unique
  notes           String?
  createdByUserId String
  createdByUser   User                 @relation("SubscriptionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  payments        Payment[]
  paymentOperations PaymentOperation[]
  ledgerEntries   SubscriptionLedger[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([studentId, status])
  @@index([branchId, status])
  @@index([tariffId])
  @@index([startsAt, expiresAt])
  @@index([createdByUserId])
}

model Payment {
  id                String        @id @default(cuid())
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount            Int
  paymentMethod     PaymentMethod
  status            PaymentStatus @default(COMPLETED)
  paidAt            DateTime
  comment           String?
  externalReference String?
  createdByUserId   String
  createdByUser     User          @relation("PaymentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  refunds           Refund[]
  operation         PaymentOperation?
  attendanceLessonId String?
  attendanceTariffId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([studentId, paidAt])
  @@index([subscriptionId])
  @@index([branchId, paidAt])
  @@index([paymentMethod, paidAt])
  @@index([status, paidAt])
  @@index([createdByUserId, paidAt])
  @@index([externalReference])
}

model PaymentOperation {
  id                  String                 @id @default(cuid())
  idempotencyKey      String                 @unique
  studentId           String
  student             Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subscriptionId      String?
  subscription        Subscription?          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  branchId            String
  branch              Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount              Int
  currency            String                 @default("RUB")
  purpose             String
  status              PaymentOperationStatus @default(CREATED)
  providerType        PaymentProviderType     @default(NONE)
  providerOperationId String?
  paymentId           String?                @unique
  payment             Payment?               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attendanceLessonId  String?
  attendanceTariffId  String?
  saleTariffId        String?
  saleStartsAt        DateTime?
  saleExpiresAt       DateTime?
  salePrice           Int?
  saleNotes           String?
  saleFinalizationError String?
  saleFinalizationAttempts Int            @default(0)
  saleFinalizedAt     DateTime?
  completedAt         DateTime?
  failureReason       String?
  cancellationReason  String?
  createdByUserId     String
  createdByUser       User                   @relation("PaymentOperationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([providerType, providerOperationId])
  @@index([studentId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([branchId, status, createdAt])
  @@index([status, updatedAt])
  @@index([createdByUserId, createdAt])
}

model Refund {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount          Int
  reason          String
  refundedAt      DateTime
  createdByUserId String
  createdByUser   User     @relation("RefundCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([paymentId, refundedAt])
  @@index([createdByUserId, refundedAt])
}

model SubscriptionLedger {
  id               String               @id @default(cuid())
  subscriptionId   String
  subscription     Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  studentId        String
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  lessonId         String?
  lesson           Lesson?              @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  attendanceId     String?
  type             LedgerOperationType
  lessonDelta      Int                  @default(0)
  amountDelta      Int?
  comment          String?
  createdByUserId  String?
  createdByUser    User?                @relation("LedgerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reversesLedgerId String?              @unique
  reversesLedger   SubscriptionLedger?  @relation("LedgerReversal", fields: [reversesLedgerId], references: [id], onDelete: Restrict)
  reversals        SubscriptionLedger[] @relation("LedgerReversal")
  createdAt        DateTime             @default(now())

  @@index([subscriptionId, createdAt])
  @@index([studentId, createdAt])
  @@index([lessonId])
  @@index([attendanceId, type])
  @@index([createdByUserId])
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  description String?
  isActive    Boolean   @default(true)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  @@index([branchId, isActive])
  @@index([name])
  @@index([archivedAt])
}

model Expense {
  id                String               @id @default(cuid())
  branchId          String
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  categoryId        String
  category          ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount            Int
  spentAt           DateTime
  paymentMethod     ExpensePaymentMethod
  vendor            String?
  description       String
  documentNumber    String?
  attachmentPath    String?
  status            ExpenseStatus        @default(DRAFT)
  createdByUserId   String
  createdByUser     User                 @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedByUserId String?
  confirmedByUser   User?                @relation("ExpenseConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([branchId, spentAt])
  @@index([categoryId, spentAt])
  @@index([status, spentAt])
  @@index([paymentMethod, spentAt])
  @@index([createdByUserId, spentAt])
  @@index([documentNumber])
}

model CashRegister {
  id             String            @id @default(cuid())
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name           String
  type           CashRegisterType
  openingBalance Int               @default(0)
  isActive       Boolean           @default(true)
  transactions   CashTransaction[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([branchId, isActive])
  @@index([type, isActive])
}

model CashTransaction {
  id              String                @id @default(cuid())
  cashRegisterId  String
  cashRegister    CashRegister          @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type            CashTransactionType
  amount          Int
  sourceType      CashTransactionSource
  sourceId        String?
  occurredAt      DateTime
  comment         String?
  createdByUserId String
  createdByUser   User                  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())

  @@index([cashRegisterId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([sourceType, sourceId])
  @@index([createdByUserId, occurredAt])
}

model PayrollRule {
  id                String      @id @default(cuid())
  coachId           String
  coach             User        @relation("PayrollCoach", fields: [coachId], references: [id], onDelete: Restrict)
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  groupId           String?
  group             DanceGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  type              PayrollType
  fixedAmount       Int?
  amountPerAttendee Int?
  percent           Float?
  monthlyAmount     Int?
  validFrom         DateTime
  validTo           DateTime?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([coachId, branchId, groupId, isActive])
  @@index([validFrom, validTo])
}

model PayrollPeriod {
  id               String              @id @default(cuid())
  dateFrom         DateTime
  dateTo           DateTime
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status           PayrollPeriodStatus @default(DRAFT)
  createdByUserId  String
  createdByUser    User                @relation("PayrollCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId String?
  approvedByUser   User?               @relation("PayrollApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  accruals         PayrollAccrual[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([branchId, dateFrom, dateTo])
  @@index([status, dateFrom])
}

model PayrollAccrual {
  id               String        @id @default(cuid())
  payrollPeriodId  String
  payrollPeriod    PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  coachId          String
  coach            User          @relation("PayrollAccrualCoach", fields: [coachId], references: [id], onDelete: Restrict)
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  groupId          String?
  group            DanceGroup?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  lessonId         String?
  lesson           Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  type             PayrollType
  baseAmount       Int
  attendeeCount    Int?
  revenueBase      Int?
  calculatedAmount Int
  manualAdjustment Int           @default(0)
  finalAmount      Int
  comment          String?
  createdAt        DateTime      @default(now())

  @@unique([payrollPeriodId, coachId, lessonId, type])
  @@index([payrollPeriodId, coachId])
  @@index([branchId, coachId])
  @@index([lessonId])
}

model StudentContact {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName       String
  relationship   String
  phone          String
  secondaryPhone String?
  email          String?
  telegram       String?
  whatsapp       Boolean   @default(false)
  isPrimary      Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  signedDocuments StudentDocument[] @relation("StudentDocumentSigner")

  @@index([studentId, archivedAt])
  @@index([studentId, isPrimary])
  @@index([phone])
}

model StudentDocument {
  id                      String                @id @default(cuid())
  studentId               String
  student                 Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  documentType            StudentDocumentType
  documentDate            DateTime
  status                  String
  source                  StudentDocumentSource
  representativeContactId String?
  representativeContact   StudentContact?       @relation("StudentDocumentSigner", fields: [representativeContactId], references: [id], onDelete: SetNull)
  attachmentMediaId       String?
  attachmentFileName      String?
  attachmentMimeType      String?
  note                    String?
  contractDetail          StudentContractDetail?
  statusHistory           StudentDocumentStatusHistory[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([studentId, documentType, documentDate])
  @@index([representativeContactId])
}

model StudentContractDetail {
  documentId     String          @id
  document       StudentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  contractNumber String          @unique
}

model StudentDocumentStatusHistory {
  id              String          @id @default(cuid())
  documentId      String
  document        StudentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  previousStatus  String?
  status          String
  changedByUserId String
  changedAt       DateTime        @default(now())

  @@index([documentId, changedAt])
}

model ContractNumberSequence {
  year       Int      @id
  nextNumber Int
  updatedAt  DateTime @updatedAt
}

model StudentNote {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  authorUserId String
  author       User      @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  text         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  @@index([studentId, archivedAt, createdAt])
  @@index([authorUserId, createdAt])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?
  status    String   @default("lead")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

model Company {
  id            String        @id @default(cuid())
  name          String
  website       String?
  industry      String?
  contacts      Contact[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([name])
}

model Opportunity {
  id        String   @id @default(cuid())
  title     String
  value     Int      @default(0)
  stage     String   @default("lead")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([stage])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  title     String
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SyncOutbox {
  id             String           @id @default(cuid())
  entityType     String
  entityId       String
  operation      SyncOperation    @default(UPSERT)
  payloadVersion Int              @default(1)
  payloadJson    String           @default("{}")
  baseRevision   Int              @default(0)
  idempotencyKey String           @unique
  status         SyncOutboxStatus @default(PENDING)
  attemptCount   Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  lastAttemptAt  DateTime?
  lastErrorCode  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  syncedAt       DateTime?

  @@index([status, nextAttemptAt, createdAt])
  @@index([entityType, entityId, createdAt])
}

model SyncEntityState {
  entityType      String
  entityId        String
  revision        Int
  serverSequence  Int
  sourceDeviceId  String
  serverUpdatedAt DateTime
  updatedAt       DateTime @updatedAt

  @@id([entityType, entityId])
  @@index([serverSequence])
}

model SyncConflict {
  id                   String    @id @default(cuid())
  serverConflictId     String?   @unique
  entityType           String
  entityId             String
  baseRevision         Int
  canonicalRevision    Int
  canonicalOperation   String
  canonicalPayloadJson String
  candidateOperation   String
  candidatePayloadJson String
  sourceDeviceId       String?
  status               String    @default("OPEN")
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?

  @@index([status, createdAt])
  @@index([entityType, entityId, status])
}

model SyncLog {
  id           String   @id @default(cuid())
  outboxId     String?
  entityType   String?
  entityId     String?
  operation    String?
  result       String
  attemptCount Int      @default(0)
  errorCode    String?
  message      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([result, createdAt])
}

model WebAction {
  id                      String   @id @default(cuid())
  externalActionId        String   @unique
  actionType              String
  crmStudentId            String?
  crmSubscriptionId       String?
  crmTrainerId            String?
  crmLessonId             String?
  payloadJson             String?
  reason                  String?
  status                  String   @default("PENDING")
  receivedAt              DateTime @default(now())
  claimedAt               DateTime?
  processedAt             DateTime?
  processedByUserId       String?
  safeResultJson          String?
  safeError               String?
  completionAttemptCount  Int      @default(0)
  nextCompletionAttemptAt DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status, receivedAt])
  @@index([crmStudentId])
  @@index([crmSubscriptionId])
  @@index([crmTrainerId])
  @@index([crmLessonId])
  @@index([nextCompletionAttemptAt])
}

model Publication {
  id               String                      @id @default(cuid())
  type             PublicationType
  title            String
  body             String
  status           PublicationStatus           @default(DRAFT)
  audienceMode     PublicationAudienceMode
  mediaLocalPath   String?
  mediaFileName    String?
  mediaContentType String?
  mediaRef         String?
  publishAt        DateTime?
  expiresAt        DateTime?
  eventStartsAt    DateTime?
  eventLocation    String?
  createdByUserId  String
  createdBy        User                        @relation("PublicationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  targets          PublicationAudienceTarget[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  archivedAt       DateTime?

  @@index([status, publishAt, createdAt])
  @@index([createdByUserId])
}

model PublicationAudienceTarget {
  publicationId String
  publication   Publication           @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  type          PublicationTargetType
  targetId      String

  @@id([publicationId, type, targetId])
  @@index([type, targetId])
}
