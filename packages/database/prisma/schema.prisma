generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  BRANCH_MANAGER
  COACH
}

enum StudentStatus {
  ACTIVE
  TRIAL
  FROZEN
  LEFT
  ARCHIVED
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum GroupStatus {
  ACTIVE
  RECRUITING
  PAUSED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  TRIAL
  FROZEN
  LEFT
}

enum LessonStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
  TRIAL
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  fullName           String
  passwordHash       String
  role               UserRole
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  branchAssignments  UserBranch[]
  sessions           Session[]
  coachedGroups      DanceGroup[]      @relation("GroupCoach")
  assistedGroups     DanceGroup[]      @relation("GroupAssistant")
  scheduleTemplates  WeeklySchedule[]  @relation("ScheduleCoach")
  lessons            Lesson[]          @relation("LessonCoach")
  attendanceMarks    Attendance[]
  auditLogs          AuditLog[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([role, isActive])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Branch {
  id          String       @id @default(cuid())
  name        String
  address     String
  phone       String
  description String?
  isActive    Boolean      @default(true)
  users       UserBranch[]
  students    Student[]
  groups      DanceGroup[]
  schedules   WeeklySchedule[]
  lessons     Lesson[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
  @@index([isActive])
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model Student {
  id          String          @id @default(cuid())
  firstName   String
  lastName    String
  middleName  String?
  birthDate   DateTime?
  gender      Gender?
  phone       String?
  email       String?
  status      StudentStatus   @default(ACTIVE)
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  notes       String?
  contacts    StudentContact[]
  enrollments Enrollment[]
  attendance  Attendance[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  @@index([branchId, status])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([archivedAt])
}

model DanceGroup {
  id               String           @id @default(cuid())
  name             String
  branchId         String
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  direction        String
  ageFrom          Int?
  ageTo            Int?
  coachId          String?
  coach            User?            @relation("GroupCoach", fields: [coachId], references: [id], onDelete: SetNull)
  assistantCoachId String?
  assistantCoach   User?            @relation("GroupAssistant", fields: [assistantCoachId], references: [id], onDelete: SetNull)
  capacity         Int              @default(20)
  status           GroupStatus      @default(RECRUITING)
  description      String?
  color            String?
  enrollments      Enrollment[]
  schedules        WeeklySchedule[]
  lessons          Lesson[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  archivedAt       DateTime?

  @@index([branchId, status])
  @@index([coachId])
  @@index([assistantCoachId])
  @@index([name])
  @@index([direction])
  @@index([archivedAt])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     DanceGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime
  leftAt    DateTime?
  status    EnrollmentStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([studentId, status])
  @@index([groupId, status])
  @@index([groupId, leftAt])
}

model WeeklySchedule {
  id        String     @id @default(cuid())
  groupId   String
  group     DanceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  weekday   Int
  startTime String
  endTime   String
  room      String?
  coachId   String?
  coach     User?      @relation("ScheduleCoach", fields: [coachId], references: [id], onDelete: SetNull)
  validFrom DateTime
  validTo   DateTime?
  isActive  Boolean    @default(true)
  lessons   Lesson[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([branchId, weekday, isActive])
  @@index([groupId, isActive])
  @@index([coachId, weekday, isActive])
  @@index([room, weekday, isActive])
}

model Lesson {
  id                 String          @id @default(cuid())
  groupId            String
  group              DanceGroup      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  branchId           String
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coachId            String?
  coach              User?           @relation("LessonCoach", fields: [coachId], references: [id], onDelete: SetNull)
  scheduleTemplateId String?
  scheduleTemplate   WeeklySchedule? @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  startsAt           DateTime
  endsAt             DateTime
  room               String?
  status             LessonStatus    @default(PLANNED)
  cancellationReason String?
  notes              String?
  attendance         Attendance[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([groupId, startsAt])
  @@index([branchId, startsAt])
  @@index([coachId, startsAt])
  @@index([scheduleTemplateId])
  @@index([status, startsAt])
}

model Attendance {
  lessonId      String
  lesson        Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        AttendanceStatus
  markedByUserId String
  markedByUser  User             @relation(fields: [markedByUserId], references: [id], onDelete: Restrict)
  markedAt      DateTime
  comment       String?

  @@id([lessonId, studentId])
  @@index([studentId, markedAt])
  @@index([markedByUserId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  entityType  String
  entityId    String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model StudentContact {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName       String
  relationship   String
  phone          String
  secondaryPhone String?
  email          String?
  telegram       String?
  whatsapp       Boolean  @default(false)
  isPrimary      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
  @@index([studentId, isPrimary])
  @@index([phone])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?
  status    String   @default("lead")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

model Company {
  id            String        @id @default(cuid())
  name          String
  website       String?
  industry      String?
  contacts      Contact[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([name])
}

model Opportunity {
  id        String   @id @default(cuid())
  title     String
  value     Int      @default(0)
  stage     String   @default("lead")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([stage])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  title     String
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
