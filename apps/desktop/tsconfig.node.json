{
  "extends": "../../packages/config/typescript/base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "noEmit": true,
    "outDir": ".tsbuild/node",
    "rootDir": ".",
    "tsBuildInfoFile": ".tsbuild/node.tsbuildinfo",
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "tailwind.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "tests/e2e/**/*.ts"
  ]
}
