{
  "name": "@arava/desktop",
  "version": "0.5.2",
  "private": true,
  "description": "ARAVA CRM — приложение для управления школой",
  "author": "ARAVA",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "package": "node ../../scripts/run-electron-builder.mjs --dir",
    "package:mac": "npm run prepackage:mac && node ../../scripts/run-electron-builder.mjs --mac --universal --publish never",
    "package:mac:dev": "npm run prepackage:mac && node ../../scripts/run-electron-builder.mjs --config electron-builder.dev.yml --mac --universal --publish never",
    "package:win": "node ../../scripts/run-electron-builder.mjs --win nsis --x64 --publish never",
    "release:mac": "npm run prepackage:mac && node ../../scripts/run-electron-builder.mjs --mac --universal --publish always",
    "release:win": "npm run prepackage:win && node ../../scripts/run-electron-builder.mjs --win nsis --x64 --publish always",
    "release:win:dev": "npm run prepackage:win && node ../../scripts/run-electron-builder.mjs --config electron-builder.dev.yml --win nsis --x64 --publish always",
    "prepackage": "node ../../scripts/prepare-prisma-package.mjs native",
    "prepackage:mac": "node ../../scripts/prepare-prisma-package.mjs mac-universal",
    "prepackage:win": "node ../../scripts/prepare-prisma-package.mjs windows",
    "preview": "electron-vite preview",
    "test:e2e": "playwright test --shard=1/2 && playwright test --shard=2/2",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "docx-preview": "^0.4.0",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "@arava/config": "*",
    "@arava/database": "*",
    "@arava/shared": "*",
    "@arava/ui": "*",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.50.1",
    "@tanstack/react-query": "^5.66.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "electron-log": "^5.3.2",
    "electron-vite": "^3.0.0",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  }
}
