    "@playwright/test": "^1.50.1",
    "@tanstack/react-query": "^5.66.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "electron-log": "^5.3.2",
