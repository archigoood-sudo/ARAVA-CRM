  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "package": "electron-builder --dir",
    "package:win": "electron-builder --win nsis --x64",
    "prepackage": "node ../../scripts/prepare-prisma-package.mjs native",
    "prepackage:win": "node ../../scripts/prepare-prisma-package.mjs windows",
